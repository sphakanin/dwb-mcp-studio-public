<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="DWB · Core Dashboard" Width="1240" Height="850" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen"
 Background="#0D151F" Foreground="#E9F0F7" FontFamily="Leelawadee UI, Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="CellText" TargetType="TextBlock"><Setter Property="Margin" Value="12,0,4,0"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1B3041"/><Setter Property="Foreground" Value="#E9F0F7"/><Setter Property="BorderBrush" Value="#345064"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#08B8D2"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="White"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="Background" Value="#101F2B"/><Setter Property="Foreground" Value="#DAE7F0"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="RowBackground" Value="#101F2B"/><Setter Property="AlternatingRowBackground" Value="#142531"/>
   <Setter Property="GridLinesVisibility" Value="None"/><Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
   <Setter Property="RowHeight" Value="38"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="CanUserReorderColumns" Value="False"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#1A3040"/><Setter Property="Foreground" Value="#93B3C5"/><Setter Property="Padding" Value="12,11"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#122333" Padding="22,28">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="CORE / WINDOWS" Foreground="#688FA5" FontSize="10"/><TextBlock x:Name="Version" Foreground="#97B1C2" FontSize="11" Margin="0,5,0,0"/><TextBlock Text="เลือกการเปิด / ปิดแอปได้&#10;ในเมนูด้านบนหรือ tray" Foreground="#97B1C2" FontSize="12" Margin="0,18,0,0"/></StackPanel>
    <StackPanel>
     <Image x:Name="Logo" Width="98" Height="98" HorizontalAlignment="Left"/>
     <TextBlock Text="MCP Studio" FontSize="24" FontWeight="SemiBold" Margin="0,18,0,0"/>
     <TextBlock Text="Core dashboard" Foreground="#08B8D2" Margin="0,4,0,36"/>
     <Border Background="#1B394B" CornerRadius="8" Padding="14,12"><TextBlock Text="ภาพรวมระบบ" Foreground="#83E4F1"/></Border>
     <Button x:Name="Connection" Content="ตั้งค่า Tunnel / API key" Margin="0,14,0,0" Padding="8,12"/>
     <Button x:Name="MachineSetup" Content="ตั้งค่าเครื่อง" Margin="0,10,0,0"/>
     <Button x:Name="AppPreferences" Content="การเปิดและปิดแอป" Margin="0,10,0,0"/>
     <Button x:Name="Skills" Content="Agent Skills" Margin="0,10,0,0"/>
     <Button x:Name="WorkspaceHelp" Content="วิธีใช้ Workspace" Margin="0,10,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,25,28,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="175"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="ภาพรวมการทำงาน" FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="Updated" Text="กำลังอ่านสถานะ…" Foreground="#8BAABD" Margin="0,7,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Refresh" Content="รีเฟรช"/><Button x:Name="StopMcp" Content="Stop" Margin="9,0,0,0"/><Button x:Name="StartMcp" Content="Start MCP →" Background="#08B8D2" Foreground="#06252E" BorderBrush="#08B8D2" FontWeight="Bold" Margin="9,0,0,0"/></StackPanel>
   </Grid>
   <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,20">
    <Border Background="#142735" CornerRadius="10" Padding="17,15" Margin="0,0,10,0"><StackPanel><TextBlock Text="TUNNEL" FontSize="10" Foreground="#89AABE"/><TextBlock x:Name="TunnelStatus" Text="—" FontSize="22" Margin="0,7,0,0"/><TextBlock x:Name="TunnelDetail" Text="การเชื่อมต่อ OpenAI" Foreground="#89AABE" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
    <Border Background="#142735" CornerRadius="10" Padding="17,15" Margin="0,0,10,0"><StackPanel><TextBlock Text="BROKER" FontSize="10" Foreground="#89AABE"/><TextBlock x:Name="BrokerStatus" Text="—" FontSize="22" Margin="0,7,0,0"/><TextBlock x:Name="BrokerDetail" Text="ตัวจัดการ worker" Foreground="#89AABE" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
    <Border Background="#142735" CornerRadius="10" Padding="17,15" Margin="0,0,10,0"><StackPanel><TextBlock Text="WORKERS" FontSize="10" Foreground="#89AABE"/><TextBlock x:Name="Workers" Text="—" FontSize="28" Margin="0,3,0,0"/><TextBlock x:Name="WorkerDetail" Text="จำนวนที่เปิด / สูงสุด" Foreground="#89AABE" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
    <Border Background="#142735" CornerRadius="10" Padding="17,15"><StackPanel><TextBlock Text="งานรอในคิว" FontSize="10" Foreground="#89AABE"/><TextBlock x:Name="Queue" Text="—" FontSize="28" Margin="0,3,0,0"/><TextBlock x:Name="QueueDetail" Text="คำขอที่รอ worker" Foreground="#89AABE" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
   </UniformGrid>
   <Grid Grid.Row="2" Margin="0,0,0,10"><TextBlock Text="Workers และ Sessions" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="SessionCount" Text="—" HorizontalAlignment="Right" Foreground="#8BAABD"/></Grid>
   <Grid Grid.Row="3" MinHeight="150">
    <DataGrid x:Name="Sessions"><DataGrid.Columns>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Workspace" Binding="{Binding Workspace}" Width="*" MinWidth="140"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="Session" Binding="{Binding Session}" Width="105"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="สถานะ" Binding="{Binding State}" Width="105"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="PID" Binding="{Binding Pid}" Width="72"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="คำขอ" Binding="{Binding InFlight}" Width="60"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="คิว" Binding="{Binding Queue}" Width="55"/>
     <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="ล่าสุด" Binding="{Binding LastActive}" Width="85"/>
    </DataGrid.Columns></DataGrid>
    <TextBlock x:Name="Empty" Text="ยังไม่มี session · เรียกเครื่องมือจากแชทเพื่อเริ่มงาน" Foreground="#89AABE" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
   </Grid>
   <Grid Grid.Row="4" Margin="0,18,0,10"><TextBlock Text="เหตุการณ์ล่าสุด" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="เลือกแถวเพื่อดูรายละเอียดด้านล่าง" HorizontalAlignment="Right" Foreground="#8BAABD" FontSize="11" VerticalAlignment="Center"/></Grid>
   <DataGrid Grid.Row="5" x:Name="Events"><DataGrid.Columns>
    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="เวลา" Binding="{Binding Time}" Width="85"/>
    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="ผล" Binding="{Binding Status}" Width="65"/>
    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="เหตุการณ์ / เครื่องมือ" Binding="{Binding Event}" Width="*"/>
    <DataGridTextColumn ElementStyle="{StaticResource CellText}" Header="รายละเอียด" Binding="{Binding Detail}" Width="2*"/>
   </DataGrid.Columns></DataGrid>
   <StackPanel Grid.Row="6" Margin="0,12,0,0"><TextBox x:Name="Detail" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Text="เลือก session เพื่อดูโฟลเดอร์เต็ม หรือเลือกเหตุการณ์เพื่อดูข้อผิดพลาด" FontSize="12" Foreground="#9AB9CA" MaxHeight="60"/><TextBlock x:Name="ActionStatus" Text="Dashboard อ่านสถานะโดยไม่เปิด worker เพิ่ม · Stop หยุด tunnel ส่วนงานใน broker อาจยังทำงานต่อ" FontSize="11" Foreground="#6F96AC" Margin="0,8,0,0"/></StackPanel>
  </Grid>
 </Grid>
</Window>
